{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "wheuat-mcp",
      "version": "0.1.0",
      "title": "WHEUAT"
    },
    "tools": [
      {
        "name": "get_featured_content",
        "title": "Get featured WHEUAT content",
        "description": "List recent public content on WHEUAT (podcasts, videos, songs, battles, or feed posts). Use this to see what creators are publishing.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "podcasts",
                "videos",
                "songs",
                "battles",
                "posts"
              ],
              "description": "Which type of content to fetch."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25,
              "default": 10,
              "description": "How many items to return (max 25)."
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "ask_jhi",
        "title": "Ask Jhi (WHEUAT creative companion)",
        "description": "Ask Jhi — WHEUAT's AI creative companion for indie artists and creators — a question about content ideas, music, channel growth, or the WHEUAT platform.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "The question or request for Jhi."
            }
          },
          "required": [
            "prompt"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
